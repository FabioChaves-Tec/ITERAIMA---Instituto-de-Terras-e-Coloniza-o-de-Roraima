{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "role": { "type": "string", "enum": ["admin", "editor", "viewer", "pending"], "description": "User role" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Approval status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation date" }
      },
      "required": ["uid", "email", "role", "status", "createdAt"]
    },
    "News": {
      "title": "News",
      "description": "News article",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "authorUid": { "type": "string" }
      },
      "required": ["id", "title", "content", "category", "createdAt", "authorUid"]
    },
    "TransparencyDocument": {
      "title": "TransparencyDocument",
      "description": "PDF document for transparency portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "year": { "type": "string" },
        "url": { "type": "string" },
        "uploadDate": { "type": "string", "format": "date-time" },
        "authorUid": { "type": "string" }
      },
      "required": ["id", "name", "category", "year", "url", "uploadDate", "authorUid"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "News articles"
    },
    "/documents/{docId}": {
      "schema": "TransparencyDocument",
      "description": "Transparency documents"
    }
  }
}
